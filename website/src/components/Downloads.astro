---
// Every file for one mark, grouped the way people look for them.
interface Props {
  mark: string;
}
const { mark } = Astro.props;
const base = `${import.meta.env.BASE_URL}assets/logos/${mark}`;
const svg = (v: string) => ({ label: v || 'standard', href: `${base}/svg/${mark}${v ? `-${v}` : ''}.svg` });
const png = (v: string, s: number) => ({ label: `${s}`, href: `${base}/png/${mark}${v ? `-${v}` : ''}-${s}.png` });
const rows = [
  { what: 'On dark backgrounds', svg: [svg(''), svg('small')], png: [256, 512, 1024].map((s) => png('', s)) },
  { what: 'On light backgrounds', svg: [svg('light'), svg('small-light')], png: [256, 512, 1024].map((s) => png('light', s)) },
  { what: 'Rounded tile', svg: [svg('tile'), svg('small-tile')], png: [16, 32, 48, 64, 128, 256, 512, 1024].map((s) => png('tile', s)) },
  { what: 'Square, for avatars', svg: [svg('square'), svg('small-square')], png: [16, 32, 48, 64, 128, 180, 192, 256, 512, 1024].map((s) => png('square', s)) },
  { what: 'Circle', svg: [svg('circle')], png: [256, 512, 1024].map((s) => png('circle', s)) },
  { what: 'Layered, for editing', svg: [svg('layered')], png: [] },
];
const web = ['favicon.svg', 'favicon.ico', 'apple-touch-icon.png', 'icon-192.png', 'icon-512.png', 'icon-maskable-512.png'];
---

<div class="cl-downloads">
  <table>
    <thead>
      <tr><th>Use</th><th>SVG</th><th>PNG (px)</th></tr>
    </thead>
    <tbody>
      {
        rows.map((r) => (
          <tr>
            <td>{r.what}</td>
            <td>{r.svg.map((l) => <a href={l.href}>{l.label}</a>)}</td>
            <td>{r.png.length ? r.png.map((l) => <a href={l.href}>{l.label}</a>) : '–'}</td>
          </tr>
        ))
      }
      <tr>
        <td>Website icons</td>
        <td colspan="2">{web.map((f) => <a href={`${base}/web/${f}`}>{f}</a>)}</td>
      </tr>
    </tbody>
  </table>
</div>
