---
// Social templates with links to each format.
interface Props {
  files: { file: string; title: string; size: string }[];
}
const { files } = Astro.props;
const base = `${import.meta.env.BASE_URL}assets/social`;
---

<div class="cl-social not-content">
  {
    files.map((f) => (
      <figure>
        <img src={`${base}/png/${f.file}.png`} alt={f.title} loading="lazy" />
        <figcaption>
          <b>{f.title}</b>
          <span>{f.size}</span>
          <span class="links">
            <a href={`${base}/png/${f.file}.png`}>PNG</a>
            <a href={`${base}/svg/${f.file}.svg`}>SVG</a>
            <a href={`${base}/source/${f.file}.svg`}>Editable SVG</a>
          </span>
        </figcaption>
      </figure>
    ))
  }
</div>
