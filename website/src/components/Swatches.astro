---
// Colour scales with their hex values.
import brand from '../data/brand.json';

interface Props {
  scales: string[];
  steps?: number[];
}
const { scales, steps = [100, 200, 300, 400, 500, 600, 700, 800, 900] } = Astro.props;
const all = brand.scales as Record<string, Record<string, string>>;
---

<div class="cl-swatches not-content">
  {
    scales.map((name) => (
      <div class="cl-scale">
        <b>{name}</b>
        <div>
          {steps.map((s) => (
            <figure>
              <i style={`background:${all[name][String(s)]}`} />
              <figcaption>
                <span>{s}</span>
                <code>{all[name][String(s)]}</code>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    ))
  }
</div>
